{
  "name": "agenttiles",
  "version": "0.7.0",
  "description": "Mission control for Claude Code: every running session on one screen. Approve, answer and jump to the right terminal.",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "ai",
    "agents",
    "dashboard",
    "developer-tools",
    "electron",
    "svelte",
    "monitoring"
  ],
  "homepage": "https://github.com/workedbeforepush/agenttiles#readme",
  "bugs": {
    "url": "https://github.com/workedbeforepush/agenttiles/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workedbeforepush/agenttiles.git"
  },
  "license": "MIT",
  "author": "workedbeforepush",
  "engines": {
    "node": ">=22"
  },
  "main": "./out/main/index.js",
  "bin": {
    "agenttiles": "bin/agenttiles.js"
  },
  "files": [
    "bin/",
    "out/main/",
    "out/preload/",
    "out/renderer/",
    "out/hook/",
    "resources/",
    "out/cli/"
  ],
  "scripts": {
    "build:node": "node scripts/build-node.mjs",
    "dev": "npm run build:node && electron-vite dev",
    "build": "npm run build:node && electron-vite build",
    "start": "npm run build && electron-vite preview",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.node.json && node node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.web.json && svelte-check --tsconfig ./tsconfig.web.json --tsgo --threshold warning",
    "test": "vitest run",
    "screenshots": "npm run build && node scripts/screenshots/build.mjs && electron out/screenshots/main.cjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "electron": "45.0.0",
    "koffi": "3.3.3",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "electron-vite": "6.0.0",
    "esbuild": "0.28.2",
    "gifenc": "1.0.3",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
